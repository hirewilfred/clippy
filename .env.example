# Copy to .env and fill in. Never commit .env.
# In cloud sessions these are injected by the environment's secure credential store instead.

# Twitch Helix API (dev.twitch.tv/console -> Register Your Application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Blotato (Settings -> API)
BLOTATO_API_KEY=

# Publisher backend: blotato (default) or postiz. Gates are identical for both.
PUBLISHER=blotato

# Postiz (Settings -> Public API). Cloud: https://api.postiz.com/public/v1
# Self-hosted: https://<your-domain>/api/public/v1
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Optional: pin channels instead of matching @clippyclubgta6
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=

# Supabase (Project settings -> API). Service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SCRAPE_CREATORS_API_KEY=
XAI_API_KEY=

# Safety switch. Nothing posts unless this is exactly "true".
LIVE=false
