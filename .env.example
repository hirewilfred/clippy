# Copy to .env and fill in. Never commit .env.
# In cloud sessions these are injected by the environment's secure credential store instead.

# Twitch Helix API (dev.twitch.tv/console -> Register Your Application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Blotato (Settings -> API)
BLOTATO_API_KEY=

# Supabase (Project settings -> API). Service role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SCRAPE_CREATORS_API_KEY=
XAI_API_KEY=

# Safety switch. Nothing posts unless this is exactly "true".
LIVE=false
